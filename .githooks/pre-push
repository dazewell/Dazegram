#!/bin/sh
# Last line of local defence for the branch name: refuse to push a change
# branch that process-rules.yml will reject on the PR.
#
# post-commit dates a branch automatically at the first commit, so this fires
# only when that didn't run — a commit made with --no-verify, a branch created
# with hooks off, or a rename that went wrong afterwards. Nothing has reached
# the remote yet at this point, so the fix is one rename with no re-push and no
# PR to retarget.
#
# Format (kept in step with .github/scripts/test-branch-name.ps1, which is the
# source of truth):  <YYYY-MM-DD> + '_' or '-' + lowercase-kebab-slug
# Month and day are range-checked, because the PS1 validator parses the date
# rather than pattern-matching it: a laxer check here would wave through
# "2026-13-01_foo", and it would fail on the PR after the push — the exact late
# failure this hook exists to prevent.
#
# Bypass in a genuine emergency only: git push --no-verify

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue

  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # An all-zero local sha is a branch deletion, which needs no valid name.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  name=${remote_ref#refs/heads/}

  case "$name" in
    dev|base|nbase|main|master) continue ;;
  esac

  if printf '%s' "$name" | grep -Eq '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[-_][a-z0-9]+(-[a-z0-9]+)*$'; then
    continue
  fi

  echo "pre-push: branch '$name' must match <YYYY-MM-DD>_<lowercase-kebab-slug>." >&2
  echo "  e.g. $(date +%Y-%m-%d)_$(printf '%s' "$name" | tr 'A-Z' 'a-z' | sed -e 's/^[0-9]\{4\}-[0-9]\{1,2\}-[0-9]\{1,2\}[-_]//' -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-*//' -e 's/-*$//')" >&2
  fail=1
done

if [ "$fail" -ne 0 ]; then
  echo "  Nothing has been pushed, so renaming is free — do it now, not after the PR exists." >&2
  echo "  Use the session's branch-rename tool where there is one, otherwise:" >&2
  echo "    git branch -m <old> <new>" >&2
  echo "  (bypass with --no-verify only in a real emergency)" >&2
  exit 1
fi

exit 0
