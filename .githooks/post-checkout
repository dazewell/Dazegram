#!/bin/sh
# Give a fresh checkout (a new worktree or clone) the media submodule the
# compile needs, from the shared local cache. See
# .github/scripts/ensure-media-submodule.sh.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Opt out for one checkout: NAX_NO_MEDIA_SUBMODULE=1 git worktree add ...

# $1 is the all-zero object id only on the initial checkout; branch switches are left alone.
case "$1" in
  *[!0]*) exit 0 ;;
esac
[ "${NAX_NO_MEDIA_SUBMODULE:-}" = "1" ] && exit 0

script="$(git rev-parse --show-toplevel)/.github/scripts/ensure-media-submodule.sh"
[ -f "$script" ] || exit 0
sh "$script" || echo "post-checkout: media submodule not set up; the compile fails until 'sh .github/scripts/ensure-media-submodule.sh' succeeds." >&2
exit 0
