<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The text memo's window. No starting window: it would flash the theme's plain background before the chat
         wallpaper is drawn. -->
    <style name="Theme.TMessages.TextMemo" parent="Theme.TMessages">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- The text memo with its Background off: a floating window just the card's size, as VoIPPermissionActivity's is.
         ColorOS opened a merely translucent one as a full-screen opaque task and showed black behind it until a runtime
         conversion landed a second or two later. Translucency can't change at runtime, so this is its own activity.
         No starting window either: ColorOS adds one even for a translucent activity, and it shows black. -->
    <style name="Theme.TMessages.TextMemoCard" parent="Theme.TMessages.Transparent">
        <item name="android:windowDisablePreview">true</item>
    </style>

</resources>
