<?xml version="1.0" encoding="utf-8"?>
<!-- NagramX: composer-toolbar copy of iv_fullscreen (the rich-editor "expand" brackets). Upstream
     ships iv_fullscreen and other surfaces still use it, so the geometry correction lives here. Its
     ink is centred already but only fills 65.3% of the 72-unit canvas, so the group scales it about
     the centre up to the 74% horizontal keyline the untouched toolbar icons use. The registry no
     longer needs an iconScale for the rich button. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <group
        android:pivotX="36"
        android:pivotY="36"
        android:scaleX="1.1336"
        android:scaleY="1.1336">
        <path
            android:strokeColor="#ffffff"
            android:strokeWidth="5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M15 57L30.5 41.5M15 42V57H30M57 15L41.5 30.5M57 30V15L42 15" />
    </group>
</vector>
