<?xml version="1.0" encoding="utf-8"?>
<!-- NagramX: double chevron, wings pulling apart to grow the input. Replaces a corner-bracket
     glyph that read as a near-twin of nax_formatting_select_all.xml in the same toolbar row.

     Built on the outgoing glyph's own 4/9/15/20 vertical grid, with shorter horizontal reach so
     the caps read cleaner in the compact toolbar row.
     Its collapsed twin is nax_composer_collapse.xml, matched to the same figures on purpose so the
     button does not change apparent size when it toggles.

     Measured: 10.46% ink, bounding box 67.19 x 73.44% of the canvas, ink centre 50.00 / 50.00. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M4.75,9 L12,4 L19.25,9 M4.75,15 L12,20 L19.25,15"
        android:strokeColor="#ff000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
